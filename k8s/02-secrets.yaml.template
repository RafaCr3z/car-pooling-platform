# ==============================================================================
# KUBERNETES SECRETS TEMPLATE (DevSecOps Best Practice)
# ==============================================================================
# AVISO: Nunca armazene segredos de produção em texto limpo no controlo de versões!
#
# Em ambientes reais / produção, aplique os segredos usando uma das opções abaixo:
#
# OPÇÃO A: Criar diretamente via CLI (recomendado para CI/CD):
#   kubectl create secret generic carpooling-secrets -n carpooling \
#     --from-literal=POSTGRES_PASSWORD="${POSTGRES_PASSWORD}" \
#     --from-literal=JWT_SECRET="${JWT_SECRET}" \
#     --from-literal=RABBITMQ_USER="${RABBITMQ_USER}" \
#     --from-literal=RABBITMQ_PASS="${RABBITMQ_PASS}"
#
# OPÇÃO B: Bitnami Sealed Secrets (GitOps seguro):
#   kubeseal --format=yaml < 02-secrets.yaml.template > 02-sealed-secrets.yaml
#
# OPÇÃO C: External Secrets Operator (HashiCorp Vault / AWS Secrets Manager)
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: carpooling-secrets
  namespace: carpooling
type: Opaque
stringData:
  POSTGRES_PASSWORD: "${POSTGRES_PASSWORD}"
  JWT_SECRET: "${JWT_SECRET}"
  RABBITMQ_USER: "${RABBITMQ_USER}"
  RABBITMQ_PASS: "${RABBITMQ_PASS}"
