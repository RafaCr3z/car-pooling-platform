# ==============================================================================
# CAR POOLING & SHARING PLATFORM - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# INSTRUÇÕES DE SEGURANÇA (DevSecOps):
# 1. Copie este ficheiro para '.env':
#    cp .env.example .env
# 2. NUNCA faça commit do ficheiro '.env' real para o repositório Git.
# 3. Em ambientes Cloud/Kubernetes, utilize Kubernetes Secrets, HashiCorp Vault
#    ou AWS Secrets Manager / Azure Key Vault para gerir estes valores.
# ==============================================================================

# --- SEGREDOS DE AUTENTICAÇÃO (JWT) ---
# Chave HMAC-SHA256 (mínimo de 32 caracteres / 256 bits).
# Gere uma chave segura com: openssl rand -hex 32
JWT_SECRET=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b
JWT_EXPIRATION_MS=86400000

# --- BASE DE DADOS POSTGRESQL ---
POSTGRES_USER=carpooling
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- MESSAGE BROKER (RABBITMQ) ---
RABBITMQ_USER=carpooling_user
RABBITMQ_PASS=your_secure_rabbitmq_password_here
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672

# --- DISTRIBUTED CACHE & RATE LIMITING (REDIS) ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# --- OBSERVABILIDADE & DISTRIBUTED TRACING (GRAFANA TEMPO) ---
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces

# --- SERVICE DISCOVERY (NETFLIX EUREKA) ---
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=true
